# Contoh konfigurasi API Portal Psikotes.
# Salin menjadi backend/.env lalu isi. Berkas .env tidak boleh di-commit atau dikirim lewat chat/email.
# Penjelasan lengkap tiap variabel: DEPLOY.md bagian 6.

# --- Database (wajib) ---
# Alamat dan port SQL Server
DB_HOST=
DB_PORT=
# Nama database. Produksi: BA
DB_NAME=
# Akun aplikasi: hanya SELECT, INSERT, UPDATE, DELETE pada tabel dbo.HCIS_Psikotes_*
DB_USER=
DB_PASSWORD=
# Koneksi terenkripsi. Bawaan: true
DB_ENCRYPT=true
# Isi true hanya bila SQL Server memakai sertifikat self-signed. Bawaan: false
DB_TRUST_CERT=false

# --- Aplikasi ---
# production = cookie hanya lewat HTTPS dan DURASI_UJI_DETIK diabaikan. Kosongkan untuk pengembangan.
NODE_ENV=
# Port API. Hanya diakses web server lokal, tutup dari luar dengan firewall. Bawaan: 3000
PORT=3000
# Alamat frontend yang boleh memanggil API. Boleh beberapa, dipisah koma
# (misalnya site peserta dan site dashboard HC bila portnya berbeda).
# Produksi: alamat https, misalnya https://psikotes.contoh.id
CORS_ORIGIN=http://localhost:4200
# Alamat portal peserta untuk tautan di email undangan. Produksi wajib https://
PORTAL_URL=http://localhost:4200
# Jumlah reverse proxy (IIS/nginx) di depan API. Produksi dengan satu proxy: 1. Pengembangan: false
TRUST_PROXY=false

# --- Login admin HC ---
# Jumlah salah sandi sebelum akun dikunci. Bawaan: 5
LOGIN_MAKS_GAGAL=5
# Lama penguncian akun dalam menit. Bawaan: 15
LOGIN_KUNCI_MENIT=15

# --- Khusus pengujian ---
# Memperpendek durasi semua tes (detik). JANGAN diisi di produksi; diabaikan bila NODE_ENV=production.
DURASI_UJI_DETIK=


TOKEN_KUNCI=
